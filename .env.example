# Copy to .env (never commit .env) and fill in what applies.

# --- Server -------------------------------------------------------------
PORT=8080
# Use 0.0.0.0 on hosting platforms / containers; 127.0.0.1 for local use.
HOST=127.0.0.1
# Set to "production" when deployed (enables HSTS + upgrade-insecure-requests).
NODE_ENV=development
# Set to "true" only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# --- Enquiry delivery (configure at least one) -------------------------
# 1) Email via Resend (https://resend.com). The FROM address must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# 2) Webhook: CRM, Zapier, Make, Google Apps Script, etc. Must be https.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# 3) Local file: for development/testing only. Stores personal data on disk.
# ENQUIRY_STORE_FILE=data/enquiries.jsonl

# --- Optional -----------------------------------------------------------
# Extra origins allowed to POST to /api/enquiry (comma-separated), e.g. a www/non-www pair.
ALLOWED_ORIGINS=
# Extra connect-src entries for the CSP if js/config.js points the form at an external service.
CSP_CONNECT_SRC=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000
